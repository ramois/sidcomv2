generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String?
  nombre         String
  apellidos      String
  ci             String
  celular        Int
  rol_id         Int
  operador_id    Int?
  estado         Estado    @default(ACTIVO)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  formExt        FormExt[]
  formInt        FormInt[]
  formCola       FormCola[]
  samplesAsGador Sample[]  @relation("ResponsableGador")
  sample         Sample[]
  operador       Operator? @relation(fields: [operador_id], references: [id])
  rol            Rol       @relation(fields: [rol_id], references: [id])
  @@map("users")
}

model Rol {
  id             Int             @id @default(autoincrement())
  nombre         String
  created_at     DateTime
  updated_at     DateTime
  rolPermissions RolPermission[] @relation("RolPermissions")
  usuarios       User[]
}

model Permission {
  id             Int             @id @default(autoincrement())
  name           String
  created_at     DateTime
  updated_at     DateTime
  rolPermissions RolPermission[] @relation("RolPermissions")
}

model RolPermission {
  permission_id Int
  role_id       Int
  permission    Permission @relation("RolPermissions", fields: [permission_id], references: [id])
  rol           Rol        @relation("RolPermissions", fields: [role_id], references: [id])

  @@id([permission_id, role_id])
  @@map("rol_permissions")
}

model Operator {
  id                          Int               @id @default(autoincrement())
  razon_social                String            @unique
  nit                         BigInt?
  nro_nim                     String?
  fecha_exp_nim               DateTime?
  tipo_operador               Int?
  nro_personeria              String?
  nro_matricula_seprec        String?
  fecha_exp_seprec            DateTime?
  tipo_doc_creacion           Int?
  doc_creacion                String?
  dl_direccion                String?
  correo_inst                 String?
  tel_fijo                    String?
  celular                     Int?
  act_exploracion             Int?              @default(0)
  act_comer_interna           Int?              @default(0)
  act_comer_externa           Int?              @default(0)
  act_industrializacion       Int?              @default(0)
  act_tras_colas              Int?              @default(0)
  act_explotacion             Int?              @default(0)
  act_ben_concentracion       Int?              @default(0)
  act_refinacion              Int?              @default(0)
  act_fundicion               Int?              @default(0)
  nro_ruex                    String?
  nro_res_ministerial         Int?
  act_calcinacion             Int?              @default(0)
  act_tostacion               Int?              @default(0)
  ci_link                     String?
  created_at                  DateTime
  doc_creacion_estatal_link   String?
  doc_explotacion_link        String?
  fax_op_min                  String?
  fecha_actualizacion         DateTime?
  fecha_creacion              DateTime?
  fecha_expiracion            DateTime?
  nim_link                    String?
  nit_link                    String?
  observaciones               String?
  ofi_lat                     String?
  ofi_lon                     String?
  otro_celular                Int?
  personeria_juridica_link    String?
  rep_celular                 Int?
  rep_ci                      String?
  rep_correo                  String?
  rep_departamento_id         Int?
  rep_direccion               String?
  rep_municipio_id            Int?
  rep_nombre_completo         String?
  rep_telefono                String?
  resolucion_min_fundind_link String?
  ruex_link                   String?
  seprec_link                 String?
  updated_at                  DateTime
  hash                        String            @unique
  estado                      Estado            @default(ACTIVO)
  tipo_nim_niar               String?
  dl_departamento_id          Int?
  dl_municipio_id             Int?
  fecha_exp_ruex              DateTime?
  verif_cert_liberacion       Boolean?          @default(false)
  comercio_interno_coperativa Boolean?          @default(false)
  transbordo                  Boolean?          @default(false)
  traslado_colas              Boolean?          @default(false)
  verificacion_toma_muestra   Boolean?          @default(false)
  arrendamientos              Arrendamiento[]   @relation("OperatorArrendamiento")
  formExt                     FormExt[]
  formInt                     FormInt[]
  formCola                    FormCola[]
  oficinas                    OficinaOperator[] @relation("OperatorOficina")
  dl_municipio                Municipios?       @relation("DlMunicipioOperator", fields: [dl_municipio_id], references: [id])
  rep_municipio               Municipios?       @relation("RepMunicipioOperator", fields: [rep_municipio_id], references: [id])
  responsableTM               ResponsableTM[]
  samples                     Sample[]
  usuarios                    User[]
}

model Arrendamiento {
  id                Int        @id @default(autoincrement())
  operador_id       Int
  codigo_unico      Int?
  extension         Decimal?
  unidad_extension  String?
  denominacion_area String?
  departamento_id   Int?
  municipio_id      Int
  tipo_explotacion  String?
  estado            Estado           @default(ACTIVO)
  municipio         Municipios @relation("ArrendamientoMunicipio", fields: [municipio_id], references: [id])
  operador          Operator   @relation("OperatorArrendamiento", fields: [operador_id], references: [id], onDelete: Cascade)
}

model OficinaOperator {
  id              Int        @id @default(autoincrement())
  operador_id     Int
  departamento_id Int?
  municipio_id    Int
  tipo            String?
  direccion       String?
  latitud         String?
  longitud        String?
  estado          Estado           @default(ACTIVO)
  municipio       Municipios @relation("OficinaMunicipio", fields: [municipio_id], references: [id])
  operador        Operator   @relation("OperatorOficina", fields: [operador_id], references: [id], onDelete: Cascade)
}

model Sample {
  id                           Int                          @id @default(autoincrement())
  lugar_verificacion           String
  tipo_muestra                 String
  observaciones                String?
  cantidad                     Int?
  created_at                   DateTime
  departamento_id              Int?
  fecha_aprobacion             DateTime?
  fecha_firma                  DateTime?
  fecha_hora_tdm               DateTime
  justificacion_anulacion      String?
  lote                         String
  municipio_id                 Int
  nro_camiones                 Int?
  nro_formulario               String                       @unique
  operador_id                  Int
  peso_neto_parcial            Decimal?
  peso_neto_total              Decimal
  responsable_tdm_gador_id     Int?
  responsable_tdm_id           Int
  responsable_tdm_senarecom_id Int?
  total_parcial                Decimal?
  ubicacion_lat                String
  ubicacion_lon                String
  updated_at                   DateTime
  user_id                      Int
  estado                       EstadoSample                 @default(GENERADO)
  hash                         String                       @unique
  presentacion_id              Int
  foto_link                    String?
  humedad                      Decimal?
  formExts                     FormExt[]                    @relation("SampleFormExt")
  municipio                    Municipios                   @relation(fields: [municipio_id], references: [id])
  operador                     Operator                     @relation(fields: [operador_id], references: [id])
  presentacion                 Presentacion                 @relation(fields: [presentacion_id], references: [id])
  responsable_gador            User?                        @relation("ResponsableGador", fields: [responsable_tdm_gador_id], references: [id])
  responsabletm                ResponsableTM                @relation(fields: [responsable_tdm_id], references: [id])
  senarecomtm                  SenarecomTM?                 @relation(fields: [responsable_tdm_senarecom_id], references: [id])
  user                         User                         @relation(fields: [user_id], references: [id])
  minerales                    SampleMineral[]
  municipio_origen             SampleMunicipio[]
  procedimiento                SampleProcedimientoMuestra[]
}

model Mineral {
  id          Int              @id @default(autoincrement())
  nombre      String
  sigla       String
  descripcion String
  tipo        String?
  estado      Estado           @default(ACTIVO)
  formExt     FormExtMineral[]
  formInt     FormIntMineral[]
  formCola    FormColaMineral[]
  sample      SampleMineral[]
}

model SampleMineral {
  sampleId  Int
  mineralId Int
  ley       Decimal?
  unidad    String?
  mineral   Mineral  @relation(fields: [mineralId], references: [id])
  sample    Sample   @relation(fields: [sampleId], references: [id])

  @@id([sampleId, mineralId])
}

model SampleMunicipio {
  sampleId    Int
  municipioId Int
  municipios  Municipios @relation(fields: [municipioId], references: [id])
  sample      Sample     @relation(fields: [sampleId], references: [id])

  @@id([sampleId, municipioId])
}

model FormExt {
  id                      Int                @id @default(autoincrement())
  id_sample               Int?
  nro_factura_exportacion String
  laboratorio             String
  tipo_transporte         String
  placa                   String?
  nom_conductor           String?
  licencia                String?
  observaciones           String?
  hash                    String             @unique
  aduana_id               Int
  cantidad                Int?
  codigo_analisis         String
  comprador               String
  created_at              DateTime
  empresa_ferrea          String?
  estado                  EstadoForm         @default(GENERADO)
  fecha_creacion          DateTime?
  fecha_ferrea            String?
  fecha_vencimiento       DateTime?
  hr_ferrea               String?
  humedad                 Decimal?
  justificacion_anulacion String?
  lote                    String
  m03_id                  String
  merma                   Decimal?
  nro_formulario          String             @unique
  nro_formulario_tm       String
  operador_id             Int
  pais_destino_id         Int
  peso_bruto_humedo       Decimal
  peso_neto               Decimal
  tara                    Decimal?
  tara_volqueta           String?
  updated_at              DateTime
  user_id                 Int
  nro_vagon               String?
  presentacion_id         Int
  aduana                  Aduana             @relation(fields: [aduana_id], references: [id])
  sample                  Sample?            @relation("SampleFormExt", fields: [id_sample], references: [id])
  operador                Operator           @relation(fields: [operador_id], references: [id])
  pais                    Pais               @relation(fields: [pais_destino_id], references: [id])
  presentacion            Presentacion       @relation(fields: [presentacion_id], references: [id])
  user                    User               @relation(fields: [user_id], references: [id])
  minerales               FormExtMineral[]
  municipio_origen        FormExtMunicipio[]
}

model FormInt {
  id                      Int                @id @default(autoincrement())
  cantidad                Int?
  peso_neto               Decimal
  tara                    Decimal?
  humedad                 Decimal?
  merma                   Decimal?
  des_tipo                String
  des_comprador           String?
  des_planta              String?
  tipo_transporte         String
  placa                   String?
  nom_conductor           String?
  licencia                String?
  nro_viajes              Int?
  observaciones           String?
  created_at              DateTime
  empresa_ferrea          String?
  estado                  EstadoForm         @default(GENERADO)
  fecha_creacion          DateTime?
  fecha_ferrea            DateTime?
  fecha_vencimiento       DateTime?
  hr_ferrea               String?
  justificacion_anulacion String?
  lote                    String
  nro_formulario          String             @unique
  nro_vagon               String?
  operador_id             Int
  peso_bruto_humedo       Decimal
  tara_volqueta           Decimal?
  traslado_mineral        String?
  updated_at              DateTime
  user_id                 Int
  hash                    String             @unique
  presentacion_id         Int
  id_municipio_destino    Int
  municipio               Municipios         @relation(fields: [id_municipio_destino], references: [id])
  operador                Operator           @relation(fields: [operador_id], references: [id])
  presentacion            Presentacion       @relation(fields: [presentacion_id], references: [id])
  user                    User               @relation(fields: [user_id], references: [id])
  minerales               FormIntMineral[]
  municipio_origen        FormIntMunicipio[]
}
model FormCola {
  id                      Int                @id @default(autoincrement())
  user_id                 Int
  operador_id             Int
  lote                    String
  nro_formulario          String             @unique
  peso_bruto_humedo       Decimal
  peso_neto               Decimal
  tara                    Decimal?
  tipo_transporte         String
  placa                   String?
  nom_conductor           String?
  licencia                String?
  nro_viajes              Int?
  observaciones           String?
  created_at              DateTime
  estado                  EstadoForm         @default(GENERADO)
  fecha_creacion          DateTime?
  fecha_vencimiento       DateTime?
  empresa_ferrea          String?
  nro_vagon               String?
  fecha_ferrea            DateTime?
  hr_ferrea               String?
  justificacion_anulacion String?
  destino                 String
  almacen                 String?
  dique_cola              String?
  updated_at              DateTime
  hash                    String             @unique
  operador                Operator           @relation(fields: [operador_id], references: [id])
  user                    User               @relation(fields: [user_id], references: [id])
  minerales               FormColaMineral[]
  municipio_origen        FormColaMunicipioOrigen[]
  municipio_destino       FormColaMunicipioDestino[]
}
model FormIntMineral {
  formIntId Int
  mineralId Int
  ley       Decimal?
  unidad    String?
  formInt   FormInt  @relation(fields: [formIntId], references: [id])
  mineral   Mineral  @relation(fields: [mineralId], references: [id])

  @@id([formIntId, mineralId])
}

model FormIntMunicipio {
  formIntId   Int
  municipioId Int
  formInt     FormInt    @relation(fields: [formIntId], references: [id])
  municipios  Municipios @relation(fields: [municipioId], references: [id])

  @@id([formIntId, municipioId])
}

model FormExtMineral {
  formExtId Int
  mineralId Int
  ley       Decimal?
  unidad    String?
  formExt   FormExt  @relation(fields: [formExtId], references: [id])
  mineral   Mineral  @relation(fields: [mineralId], references: [id])

  @@id([formExtId, mineralId])
}

model FormExtMunicipio {
  formExtId   Int
  municipioId Int
  formExt     FormExt    @relation(fields: [formExtId], references: [id])
  municipios  Municipios @relation(fields: [municipioId], references: [id])

  @@id([formExtId, municipioId])
}
model FormColaMunicipioOrigen {
  formColaId    Int
  municipioId  Int
  formCola     FormCola    @relation(fields: [formColaId], references: [id])
  municipios   Municipios @relation(fields: [municipioId], references: [id])
  @@id([formColaId, municipioId])
}
model FormColaMunicipioDestino {
  formColaId   Int
  municipioId  Int
  formCola     FormCola    @relation(fields: [formColaId], references: [id])
  municipios   Municipios @relation(fields: [municipioId], references: [id])

  @@id([formColaId, municipioId])
}
model FormColaMineral {
  formColaId    Int
  mineralId    Int
  formCola     FormCola  @relation(fields: [formColaId], references: [id])
  mineral      Mineral  @relation(fields: [mineralId], references: [id])
  @@id([formColaId, mineralId])
}
model Municipios {
  id              Int                @id @default(autoincrement())
  municipio       String
  provincia       String?
  departamento_id Int
  codigo          String
  arrendamientos  Arrendamiento[]    @relation("ArrendamientoMunicipio")
  formExt         FormExtMunicipio[]
  formInts        FormInt[]
  formInt         FormIntMunicipio[]
  formColaOrigen  FormColaMunicipioOrigen[]
  formColaDestino FormColaMunicipioDestino[]
  departamento    Departamento       @relation(fields: [departamento_id], references: [id])
  oficinas        OficinaOperator[]  @relation("OficinaMunicipio")
  dl_operators    Operator[]         @relation("DlMunicipioOperator")
  rep_operators   Operator[]         @relation("RepMunicipioOperator")
  samples         Sample[]
  sample          SampleMunicipio[]
}

model Departamento {
  id         Int          @id @default(autoincrement())
  nombre     String
  latitud    Decimal
  longitud   Decimal
  municipios Municipios[]
}

model Pais {
  id         Int       @id @default(autoincrement())
  nombre     String
  sigla      String
  continente String
  formExt    FormExt[]
}

model Aduana {
  id            Int       @id @default(autoincrement())
  nombre        String
  codigo_aduana String
  latitud       Decimal
  longitud      Decimal
  estado        Estado    @default(ACTIVO)
  formExt       FormExt[]
}

model Presentacion {
  id       Int       @id @default(autoincrement())
  nombre   String
  humedad  Int
  merma    Int
  cantidad Int
  formExt  FormExt[]
  formInt  FormInt[]
  samples  Sample[]
}

model DuracionForm {
  id                  Int      @id @default(autoincrement())
  nombre              String
  dias                Int
  fecha_actualizacion DateTime
}

model ProcedimientoMuestra {
  id            Int                          @id @default(autoincrement())
  nombre        String
  procedimiento String
  sample        SampleProcedimientoMuestra[]
}

model SampleProcedimientoMuestra {
  sampleId             Int
  procedimientoId      Int
  procedimientomuestra ProcedimientoMuestra @relation(fields: [procedimientoId], references: [id])
  sample               Sample               @relation(fields: [sampleId], references: [id])

  @@id([sampleId, procedimientoId])
}

model ResponsableTM {
  id          Int      @id @default(autoincrement())
  nombre      String
  apellidos   String
  ci          String?
  celular     Int?
  email       String?
  operador_id Int
  estado      Estado   @default(ACTIVO)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  operador    Operator @relation(fields: [operador_id], references: [id])
  sample      Sample[]
}

model SenarecomTM {
  id         Int      @id @default(autoincrement())
  nombre     String
  apellidos  String
  ci         String?
  celular    Int?
  email      String?
  cargo      String?
  estado     Estado   @default(ACTIVO)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sample     Sample[]
}

enum Estado {
  ACTIVO
  INACTIVO
}

enum EstadoSample {
  GENERADO
  SOLICITADO
  APROBADO
  FIRMADO
  ANULADO
}

enum EstadoForm {
  GENERADO
  EMITIDO
  VENCIDO
  ANULADO
}
